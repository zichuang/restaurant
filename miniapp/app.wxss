/* 全局样式：暖色餐厅调，字号按 rpx，屏幕适配交给微信 */

page {
  background: #f6f3ee;
  color: #2b2b2b;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

/* 页面通用内边距 */
.page {
  padding: 24rpx 28rpx 40rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(43, 43, 43, 0.05);
}

/* 主按钮 */
.btn-primary {
  background: #c8452d;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: #d9d3cc;
  color: #fff;
}

/* 次要按钮 */
.btn-ghost {
  background: transparent;
  color: #c8452d;
  border: 2rpx solid #c8452d;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-ghost::after {
  border: none;
}

/* 金额：主色加粗 */
.price {
  color: #c8452d;
  font-weight: 700;
}

.price-symbol {
  font-size: 24rpx;
  margin-right: 2rpx;
}

/* 灰色辅助文字 */
.muted {
  color: #8c8c8c;
  font-size: 24rpx;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #8c8c8c;
  font-size: 26rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #ece7e1;
  margin: 20rpx 0;
}
