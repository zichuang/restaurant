.menu-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6f3ee;
}

/* ---------------- 顶部桌号条 ---------------- */
.table-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #c8452d 0%, #a83420 100%);
  color: #fff;
  flex-shrink: 0;
}

.tb-left {
  display: flex;
  align-items: baseline;
}

.tb-no {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.tb-zone {
  margin-left: 14rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.tb-tip {
  font-size: 22rpx;
  opacity: 0.85;
}

/* ---------------- 状态 ---------------- */
.state-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid #e8e1d8;
  border-top-color: #c8452d;
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.err-text {
  color: #c8452d;
  font-size: 26rpx;
  text-align: center;
  line-height: 1.8;
}

.retry {
  margin-top: 32rpx;
  width: 280rpx;
}

/* ---------------- 主体 ---------------- */
.body {
  flex: 1;
  display: flex;
  overflow: hidden;
  padding-bottom: 130rpx;
}

/* 左侧分类 */
.cat-nav {
  width: 176rpx;
  flex-shrink: 0;
  background: #f1ece5;
  height: 100%;
}

.cat-item {
  padding: 30rpx 16rpx;
  font-size: 26rpx;
  color: #5c5147;
  text-align: center;
  position: relative;
  line-height: 1.4;
}

.cat-item.active {
  background: #fff;
  color: #c8452d;
  font-weight: 600;
}

.cat-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background: #c8452d;
  border-radius: 0 6rpx 6rpx 0;
}

/* 右侧菜品 */
.dish-list {
  flex: 1;
  height: 100%;
  background: #fff;
}

.cat-title {
  padding: 24rpx 24rpx 8rpx;
  font-size: 26rpx;
  color: #8c8c8c;
  font-weight: 600;
}

.dish-card {
  display: flex;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f2ede7;
}

.dish-thumb {
  width: 132rpx;
  height: 132rpx;
  border-radius: 14rpx;
  background: linear-gradient(140deg, #f6e6dc, #efd3c4);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.dish-thumb.dim {
  opacity: 0.45;
}

.thumb-char {
  font-size: 52rpx;
  font-weight: 700;
  color: #c8452d;
  opacity: 0.55;
}

.dish-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dish-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b2b2b;
  margin-right: 10rpx;
}

.dish-tag {
  font-size: 18rpx;
  color: #c8452d;
  border: 1rpx solid #e8b7a9;
  border-radius: 6rpx;
  padding: 0 6rpx;
  margin-right: 6rpx;
  line-height: 1.6;
}

.dish-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8c8c8c;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dish-bottom {
  margin-top: auto;
  padding-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-price {
  display: flex;
  align-items: baseline;
}

.price-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #c8452d;
}

.dish-unit {
  font-size: 20rpx;
  color: #a89c90;
  margin-left: 4rpx;
}

/* 加减 */
.dish-action {
  display: flex;
  align-items: center;
}

.add-btn {
  background: #c8452d;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  line-height: 1.6;
}

.step-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border: 2rpx solid #c8452d;
  color: #c8452d;
  border-radius: 50%;
  font-size: 30rpx;
}

.step-btn.plus {
  background: #c8452d;
  color: #fff;
}

.qty-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.sold-out {
  font-size: 24rpx;
  color: #b8b0a6;
}

.list-foot {
  text-align: center;
  padding: 40rpx 0 60rpx;
  font-size: 22rpx;
}

/* ---------------- 底部结算栏 ---------------- */
.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 116rpx;
  background: #2f2a26;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx 0 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 20;
}

.cart-left {
  display: flex;
  align-items: center;
}

.cart-badge {
  min-width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #c8452d;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.cart-text {
  display: flex;
  flex-direction: column;
}

.cart-total {
  color: #ffd9c9;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.cs {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.cart-hint {
  font-size: 18rpx;
  color: #9c928a;
}

.cart-go {
  background: #c8452d;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
}

/* ---------------- 规格弹层 ---------------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 30;
}

.spec-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 74vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 31;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.sp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

.sp-name {
  font-size: 34rpx;
  font-weight: 700;
}

.sp-close {
  font-size: 32rpx;
  color: #8c8c8c;
  padding: 0 10rpx;
}

.sp-body {
  max-height: 48vh;
  padding: 0 32rpx;
}

.sp-group {
  margin-bottom: 28rpx;
}

.sp-group-name {
  font-size: 26rpx;
  color: #5c5147;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.opt-row {
  display: flex;
  flex-wrap: wrap;
}

.opt {
  display: flex;
  align-items: baseline;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #f6f3ee;
  color: #5c5147;
  font-size: 26rpx;
  margin: 0 14rpx 14rpx 0;
  border: 2rpx solid transparent;
}

.opt.on {
  background: #fdf0eb;
  border-color: #c8452d;
  color: #c8452d;
  font-weight: 600;
}

.opt-delta {
  font-size: 20rpx;
  margin-left: 6rpx;
  opacity: 0.8;
}

.sp-remark {
  height: 80rpx;
  background: #f6f3ee;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.sp-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 28rpx;
  border-top: 1rpx solid #f2ede7;
}

.sp-price {
  display: flex;
  align-items: baseline;
}

.sp-price .muted {
  margin-right: 12rpx;
}

.sp-price .cart-total {
  color: #c8452d;
  font-size: 38rpx;
}
